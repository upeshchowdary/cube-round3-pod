{
  "flow_id": "specialist-no-prep-v1",
  "description": "For Specialist Pods (no Prep Manager): Receiving -> Pack -> Returns -> Recovery. FBA units get no Prep evidence, so Recovery must treat inbound-defect charges as SILENT. Handling that gracefully is part of the integration work.",
  "steps": [
    {
      "stage": "receiving"
    },
    {
      "when": {
        "route": [
          "mfn"
        ]
      },
      "stage": "pack"
    },
    {
      "when": {
        "returned": [
          true
        ]
      },
      "stage": "returns",
      "rerun_when_upstream_changes": true
    },
    {
      "stage": "recovery",
      "rerun_when_upstream_changes": true
    }
  ],
  "defaults": {
    "timeout_s": 30,
    "retries": 1,
    "on_uncertain": "continue",
    "on_error": "continue"
  }
}
